{
  "name": "projectname",
  "version": "4.1.5",
  "private": true,
  "scripts": {
    "build": "pnpm run lint && cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "build:stats": "pnpm run lint && cross-env NODE_ENV=production:stats webpack --config webpack.prod.js --profile --json > stats.json",
    "dev": "cross-env NODE_ENV=development webpack serve --hot --config webpack.dev.js",
    "lint": "eslint --fix ./src"
  },
  "sideEffects": [
    "./src/pages/global.ts"
  ],
  "dependencies": {
    "lit": "^3.3.3"
  },
